        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"mode\": \"screen\",\n  \"names\": [\n    \"Your customer one\",\n    \"Your supplier two\"\n  ],\n  \"entityType\": \"any\",\n  \"minScore\": 85,\n  \"maxMatches\": 3\n}",
        "options": {
          "timeout": 330000
        }
      },
      "id": "9e02baaf-9854-45c0-9a1f-1fa64345bc8a",
      "name": "Run sanctions-screener",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "0b202f85-4af8-4a5e-9873-028063e33ff2",
              "name": "Name",
              "value": "={{ $json.query }}",
              "type": "string"
            },
            {
              "id": "cafe0142-fca1-4a76-ba94-4f3daf276cdf",
              "name": "Verdict",
              "value": "={{ $json.status }}",
              "type": "string"
            },
            {
              "id": "43608175-d0dc-45d7-a8ff-bec147832868",
              "name": "Top score",
              "value": "={{ $json.topScore }}",
              "type": "number"
            },
            {
              "id": "18b2dae9-504a-4d58-a6bc-31f51c07769b",
              "name": "Best match",
              "value": "={{ ($json.matches || [])[0]?.name }}",
              "type": "string"
            },
            {
              "id": "fd66149d-8485-4e0c-b514-72b0c6a9fe27",
              "name": "List",
              "value": "={{ ($json.matches || [])[0]?.list }}",
              "type": "string"
            },
            {
              "id": "365df95a-3f60-419e-8c7b-575b55c42afc",
              "name": "Checked",
              "value": "={{ $now.toISODate() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c31d5474-d7a7-4f86-aa34-5c505972b4f7",
