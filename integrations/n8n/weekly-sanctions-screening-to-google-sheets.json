{
  "name": "Weekly sanctions screening to Google Sheets (Apify)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 6
            }
          ]
        }
      },
      "name": "Every Monday 6:00",
      "id": "445f98b7-73c3-472c-9405-4b2550c9a04b",
